          <mxGeometry x="232" y="105" width="36" height="36" as="geometry" />
        </mxCell>
        <mxCell id="bZpdHSspUCKo_rMtztg_-5" value="&lt;font style=&quot;font-size: 14px;&quot;&gt;Выбрать тип «переговорная»,&lt;br&gt;дату и интервал времени&lt;/font&gt;" style="rounded=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=12;strokeWidth=1.2;" vertex="1" parent="1">
          <mxGeometry x="85" y="175" width="330" height="60" as="geometry" />
        </mxCell>
        <mxCell id="bZpdHSspUCKo_rMtztg_-6" value="&lt;font style=&quot;font-size: 14px;&quot;&gt;Изменить запрос с учётом&lt;br&gt;ограничения или предложенных&lt;br&gt;ближайших интервалов&lt;/font&gt;" style="rounded=1;arcSize=22;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=12;strokeWidth=1.2;" vertex="1" parent="1">
          <mxGeometry x="85" y="295" width="330" height="80" as="geometry" />
        </mxCell>
        <mxCell id="bZpdHSspUCKo_rMtztg_-7" value="&lt;font style=&quot;font-size: 14px;&quot;&gt;Выбрать комнату и&lt;br&gt;дополнительные услуги&lt;/font&gt;" style="rounded=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=12;strokeWidth=1.2;" vertex="1" parent="1">
          <mxGeometry x="85" y="545" width="330" height="60" as="geometry" />
        </mxCell>
        <mxCell id="bZpdHSspUCKo_rMtztg_-8" value="&lt;font style=&quot;font-size: 14px;&quot;&gt;Подтвердить бронирование&lt;/font&gt;" style="rounded=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=12;strokeWidth=1.2;" vertex="1" parent="1">
          <mxGeometry x="85" y="765" width="330" height="50" as="geometry" />
        </mxCell>
        <mxCell id="bZpdHSspUCKo_rMtztg_-9" value="&lt;font style=&quot;font-size: 14px;&quot;&gt;Выбрать другой слот&lt;br&gt;(параметры сохранены)&lt;/font&gt;" style="rounded=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=12;strokeWidth=1.2;" vertex="1" parent="1">
          <mxGeometry x="85" y="990" width="330" height="60" as="geometry" />
        </mxCell>
        <mxCell id="bZpdHSspUCKo_rMtztg_-10" value="&lt;font style=&quot;font-size: 14px;&quot;&gt;Проверить параметры (до 30 дней,&lt;br&gt;не менее 30 мин) и доступность&lt;/font&gt;" style="rounded=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=12;strokeWidth=1.2;" vertex="1" parent="1">
          <mxGeometry x="585" y="175" width="330" height="60" as="geometry" />
        </mxCell>
        <mxCell id="bZpdHSspUCKo_rMtztg_-11" value="&lt;font style=&quot;font-size: 14px;&quot;&gt;Параметры верны,&lt;br&gt;комнаты свободны?&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=12;strokeWidth=1.2;" vertex="1" parent="1">
          <mxGeometry x="590" y="285" width="320" height="100" as="geometry" />
        </mxCell>
        <mxCell id="bZpdHSspUCKo_rMtztg_-12" value="&lt;font style=&quot;font-size: 14px;&quot;&gt;Показать свободные комнаты,&lt;br&gt;характеристики и стоимость&lt;/font&gt;" style="rounded=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=12;strokeWidth=1.2;" vertex="1" parent="1">
