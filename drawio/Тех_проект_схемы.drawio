        <mxCell id="bZpdHSspUCKo_rMtztg_-14" value="&lt;font style=&quot;font-size: 14px;&quot;&gt;Повторно проверить пересечение&lt;br&gt;слота в транзакции БД&lt;/font&gt;" style="rounded=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=12;strokeWidth=1.2;" vertex="1" parent="1">
