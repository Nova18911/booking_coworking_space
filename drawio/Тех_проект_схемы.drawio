        <mxCell id="hGkMW0TzMDcNGfOgXpou-5" value="&lt;font style=&quot;font-size: 14px;&quot;&gt;Показать список и детали&lt;br&gt;выбранной брони&lt;/font&gt;" style="rounded=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=12;strokeWidth=1.2;" vertex="1" parent="1">
