        <mxCell id="hGkMW0TzMDcNGfOgXpou-4" value="&lt;font style=&quot;font-size: 14px;&quot;&gt;Открыть список броней, фильтр&lt;br&gt;«ожидает подтверждения»,&lt;br&gt;выбрать бронь&lt;/font&gt;" style="rounded=1;arcSize=22;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=12;strokeWidth=1.2;" vertex="1" parent="1">
